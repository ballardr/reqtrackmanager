#!/usr/bin/env bash
# Installed automatically via frontend's `postinstall` script, which runs
# `git config core.hooksPath .githooks` — see frontend/package.json.
#
# Blocks a commit that would leave a project's package-lock.json out of sync
# with its package.json, the exact class of failure that broke CI in
# docs/decisions.md ("PR #8 CI failure..."). This is a fast, non-destructive
# check (npm ci --dry-run writes nothing to disk) rather than a Docker-based
# one, since each project's own .nvmrc now matches CI/Dockerfile's Node
# version, so a plain local npm resolves the lockfile the same way CI does.
#
# Covers every Node project in the repo that has its own lockfile-sync
# script (frontend/, docs/website/) — extend PROJECTS below if another one
# is added.
set -euo pipefail

PROJECTS=(frontend docs/website)

# The staged file list is read once; each check below asks whether any staged path matches its trigger pattern
# (an extended regular expression), instead of running `git diff` again for every check.
STAGED="$(git diff --cached --name-only)"
staged_matches() {
  grep -qE "$1" <<<"$STAGED"
}

# A Playwright version bump (either lockfile) or an image-tag edit in ci.yml
# must keep the two in step; see scripts/check-playwright-image-sync.py.
if staged_matches '^(\.github/workflows/ci\.yml|frontend/package-lock\.json|tests/playwright/package-lock\.json)$'; then
  python3 "$(git rev-parse --show-toplevel)/scripts/check-playwright-image-sync.py" || {
    echo "pre-commit: fix the Playwright image tag in .github/workflows/ci.yml (or the lockfile), re-stage, and retry." >&2
    exit 1
  }
fi

# A moved or renamed doc must not leave dangling references; see scripts/check_doc_links.py. `--staged` scans only the
# staged files unless the commit removes, renames or adds a plan, or changes the checker (then it scans everything);
# CI's `docs` job always scans everything.
if staged_matches '\.(md|py|ts|tsx|css|ya?ml|sh|txt)$|^docs/'; then
  python3 "$(git rev-parse --show-toplevel)/scripts/check_doc_links.py" --staged || {
    echo "pre-commit: fix the broken documentation reference(s) above, re-stage, and retry." >&2
    exit 1
  }
fi

# A source comment must describe the code, not the conversation or its history; see scripts/check_comment_style.py.
# `--staged` scans only the staged files (the whole repository when the checker itself is staged).
if staged_matches '\.(py|ts|tsx|js|mjs|css|sh|ya?ml|toml|ini|caddy)$|(^|/)(Dockerfile[^/]*|Caddyfile)$'; then
  python3 "$(git rev-parse --show-toplevel)/scripts/check_comment_style.py" --staged || {
    echo "pre-commit: rewrite the comment(s) above to describe what the code does now, re-stage, and retry." >&2
    exit 1
  }
fi

# Performance results are git-ignored; one force-added to a public repository must carry nothing identifying (perf/scrub_check.py).
# Only tracked and staged files are checked: the directory also holds local bundles and copied-in archives that no commit publishes.
if staged_matches '^perf/results/'; then
  python3 "$(git rev-parse --show-toplevel)/perf/scrub_check.py" --tracked || {
    echo "pre-commit: remove the identifying content above from perf/results/, re-stage, and retry." >&2
    exit 1
  }
fi

# A shipped dependency must stay within the licence policy and the third-party inventory must match the lockfiles;
# see scripts/check_licences.py (offline here; CI also resolves the Python requirements afresh).
if staged_matches '^(frontend/package-lock\.json|docs/website/package-lock\.json|backend/requirements\.txt|mcp-server/requirements\.txt|converter/requirements\.txt|scripts/licence_(policy|inventory)\.|frontend/public/licences/|(.*/)?Dockerfile[^/]*$)'; then
  python3 "$(git rev-parse --show-toplevel)/scripts/check_licences.py" || {
    echo "pre-commit: fix the licence finding(s) above, or regenerate with scripts/generate_third_party_notices.py, re-stage, and retry." >&2
    exit 1
  }
fi

# The CLA signatories file must stay well formed (a bad file blocks every contributor's check); see scripts/check_cla.py.
if staged_matches '^(\.github/cla-signatories\.json|CLA\.md)$'; then
  python3 "$(git rev-parse --show-toplevel)/scripts/check_cla.py" || {
    echo "pre-commit: fix the CLA signatories finding(s) above, re-stage, and retry." >&2
    exit 1
  }
fi

# Container health probes must use 127.0.0.1, not localhost; see scripts/check_health_probes.py.
if staged_matches '(^|/)(Dockerfile[^/]*|docker-compose[^/]*\.ya?ml)$'; then
  python3 "$(git rev-parse --show-toplevel)/scripts/check_health_probes.py" || {
    echo "pre-commit: use 127.0.0.1 (not localhost) in the health probe(s) above, re-stage, and retry." >&2
    exit 1
  }
fi

for project in "${PROJECTS[@]}"; do
  if ! staged_matches "^${project}/(package\.json|package-lock\.json)$"; then
    continue
  fi

  (
    cd "$project"

    REQUIRED_NODE_MAJOR="$(cat .nvmrc)"
    ACTUAL_NODE_MAJOR="$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo '')"
    # A commit made from an editor or a shell on another Node major: switch to the pinned one through nvm when it is installed
    # (the same version `nvm use` selects), so the check runs under the Node CI uses instead of failing on the shell's default.
    if [[ "$ACTUAL_NODE_MAJOR" != "$REQUIRED_NODE_MAJOR" && -s "${NVM_DIR:-$HOME/.nvm}/nvm.sh" ]]; then
      # shellcheck disable=SC1091
      source "${NVM_DIR:-$HOME/.nvm}/nvm.sh" >/dev/null 2>&1 || true
      nvm use --silent "$REQUIRED_NODE_MAJOR" >/dev/null 2>&1 || true
      ACTUAL_NODE_MAJOR="$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo '')"
    fi
    if [[ "$ACTUAL_NODE_MAJOR" != "$REQUIRED_NODE_MAJOR" ]]; then
      echo "pre-commit: active Node is $(node -v 2>/dev/null || echo 'not found'), but $project/.nvmrc pins Node $REQUIRED_NODE_MAJOR (matches CI/Dockerfile)." >&2
      echo "pre-commit: run 'nvm use' in $project/ first, then retry the commit." >&2
      exit 1
    fi

    echo "pre-commit: verifying $project/package-lock.json is in sync (npm ci --dry-run)..."
    if ! DRY_RUN_OUTPUT="$(npm ci --dry-run --no-audit --no-fund 2>&1)"; then
      echo "$DRY_RUN_OUTPUT" | grep -E '^npm error( code| Missing:| .*sync)' >&2 || echo "$DRY_RUN_OUTPUT" >&2
      echo "pre-commit: $project/package-lock.json is out of sync with package.json." >&2
      echo "pre-commit: run $project/scripts/sync-lockfile.sh, re-stage, and retry the commit." >&2
      exit 1
    fi
  )
done
