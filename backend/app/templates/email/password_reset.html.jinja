{#
  Password reset link (services/credential_reset.py). Sent to the account's own address by the
  "forgot password" flow, by an organisation or server administrator, or from the command line.
  Context: heading (str), intro (str), reset_url (str), expires_minutes (int). No unsubscribe link:
  this is a security message, not a notification.
#}
{% extends "base.html.jinja" %}
{% import "_macros.html.jinja" as macros %}

{% block preheader %}Choose a new password for {{ branding.header_title }}{% endblock %}
{% block heading %}{{ heading }}{% endblock %}

{% block body %}
<p style="margin: 0;">{{ intro }}</p>
<p style="margin: 12px 0 0;">This link works once and expires in {{ expires_minutes }} minutes. If you did not expect this email, you can ignore it: your password does not change unless the link is used.</p>
{% endblock %}

{% block cta %}
{{ macros.cta_button("Choose a new password", reset_url, branding) }}
{% endblock %}
