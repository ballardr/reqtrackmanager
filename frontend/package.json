{
  "name": "reqtrackmanager-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "postinstall": "git -C .. config core.hooksPath .githooks 2>/dev/null || true",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview --host --port 3000",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "vitest run --project=storybook"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "lucide-react": "^0.446.0",
    "papaparse": "^5.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-vitest": "^10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser-playwright": "^4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "playwright": "1.63.0",
    "storybook": "^10.6.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "katex": "^0.18.2"
  }
}
