# Copy to `.env` in this directory and fill in the blanks. Generate each secret with:  openssl rand -base64 36
# The stack refuses to start while a required value is empty, and the backend refuses a placeholder or short secret.

# Required
POSTGRES_PASSWORD=
JWT_SECRET=
APP_SECRET_ENCRYPTION_KEY=
SERVER_ADMIN_PASSWORD=
STORAGE_SECRET_KEY=

# First administrator (created on first start)
SERVER_ADMIN_EMAIL=admin@example.com

# Addresses (defaults suit a browser on the same host). Set both to your public URLs behind a reverse proxy.
# CORS_ORIGINS=https://reqtrack.example.com
# PUBLIC_API_BASE_URL=https://api.reqtrack.example.com
# FRONTEND_BASE_URL=https://reqtrack.example.com

# Outgoing email is off by default (invitations and password resets are not delivered).
# EMAIL_DELIVERY=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_ADDRESS=noreply@example.com

# Pin a released image version instead of tracking `latest`.
# IMAGE_TAG=
